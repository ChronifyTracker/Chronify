<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chronify.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush">#F34F78</SolidColorBrush>
        <SolidColorBrush x:Key="MutedBrush">#A29AA4</SolidColorBrush>
        <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush">#5A3A4A</SolidColorBrush>
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush">#5A3A4A</SolidColorBrush>
        <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush">#5A3A4A</SolidColorBrush>
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush">#5A3A4A</SolidColorBrush>
        <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush">Transparent</SolidColorBrush>
        <StreamGeometry x:Key="EditIcon">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</StreamGeometry>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#F34F78" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <Style Selector="Window">
            <Setter Property="Background" Value="#111014" />
            <Setter Property="Foreground" Value="#F6F1F4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#F34F78" />
            <Setter Property="Foreground" Value="#16090E" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF7797" />
            <Setter Property="Foreground" Value="#16090E" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A29AA4" />
            <Setter Property="Padding" Value="16,13" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="#301B26" />
            <Setter Property="Foreground" Value="#FF7899" />
        </Style>
        <Style Selector="TextBlock.accent">
            <Setter Property="Foreground" Value="#FF7899" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#1C191F" />
            <Setter Property="BorderBrush" Value="#302A33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#302A33" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#171419" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.overdue">
            <Setter Property="Foreground" Value="#FF6B6B" />
        </Style>
        <Style Selector="TextBlock.soon">
            <Setter Property="Foreground" Value="#F2B45A" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#1C191F" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style Selector="ComboBox, NumericUpDown, CalendarDatePicker, TimePicker">
            <Setter Property="Background" Value="#1C191F" />
            <Setter Property="Height" Value="38" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="CalendarDatePicker">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown TextBox, CalendarDatePicker TextBox">
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TimePicker /template/ TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>
