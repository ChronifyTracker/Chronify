<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chronify.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush">#F34F78</SolidColorBrush>
        <SolidColorBrush x:Key="MutedBrush">#A29AA4</SolidColorBrush>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#F34F78" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <Style Selector="Window">
            <Setter Property="Background" Value="#111014" />
            <Setter Property="Foreground" Value="#F6F1F4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#F34F78" />
            <Setter Property="Foreground" Value="#16090E" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF7797" />
            <Setter Property="Foreground" Value="#16090E" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A29AA4" />
            <Setter Property="Padding" Value="16,13" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="#301B26" />
            <Setter Property="Foreground" Value="#FF7899" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#1C191F" />
            <Setter Property="BorderBrush" Value="#302A33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#1C191F" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </Application.Styles>
</Application>
