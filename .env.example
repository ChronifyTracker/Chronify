# Скопіюйте цей файл у .env.local та заповніть потрібні значення.
# NeonSetup записує у .env.local реквізити обмеженого користувача chronify_client.
CHRONIFY_DATABASE_URL=''

# Необов'язково: реквізити Google OAuth для застосунку Desktop app.
# Їх також можна ввести у формі підключення Classroom.
CHRONIFY_GOOGLE_CLIENT_ID=''
CHRONIFY_GOOGLE_CLIENT_SECRET=''
