<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:Chronify.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chronify.ViewModels" x:Class="Chronify.Views.IntegrationsView" x:DataType="vm:IntegrationsViewModel">
    <StackPanel Spacing="12">
        <TextBlock Text="{loc:Translate Integrations.Heading}" Classes="section" />
        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="Google Classroom" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Translate Integrations.GoogleHint}" Classes="muted" TextWrapping="Wrap" />
        <TextBox Text="{Binding GoogleClientId}" Watermark="{loc:Translate Integrations.GoogleClientId}" IsEnabled="{Binding !IsBusy}" />
        <TextBox Text="{Binding GoogleClientSecret}" Watermark="{loc:Translate Integrations.GoogleClientSecret}" PasswordChar="●" IsEnabled="{Binding !IsBusy}" />
        <WrapPanel IsEnabled="{Binding !IsBusy}">
            <Button Content="{loc:Translate Integrations.ConnectGoogle}" Command="{Binding ConnectClassroomCommand}" Margin="0,0,8,8" />
            <Button Content="{loc:Translate Integrations.DisconnectClassroom}" Command="{Binding DisconnectClassroomCommand}" IsEnabled="{Binding HasClassroom}" />
        </WrapPanel>
        <TextBlock Text="Notion" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Translate Integrations.NotionHint}" Classes="muted" TextWrapping="Wrap" />
        <TextBox Text="{Binding NotionToken}" Watermark="{loc:Translate Integrations.NotionToken}" PasswordChar="●" IsEnabled="{Binding !IsBusy}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsBusy}">
            <Button Content="{loc:Translate Integrations.ConnectNotion}" Command="{Binding ConnectNotionCommand}" />
            <Button Content="{loc:Translate Integrations.DisconnectNotion}" Command="{Binding DisconnectNotionCommand}" IsEnabled="{Binding HasNotion}" />
        </StackPanel>
        <Button Content="{loc:Translate Integrations.Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding Message}" Foreground="#81C784" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8DA9" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
