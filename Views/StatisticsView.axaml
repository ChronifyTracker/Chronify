<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:Chronify.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chronify.ViewModels" xmlns:services="using:Chronify.Services" x:Class="Chronify.Views.StatisticsView" x:DataType="vm:StatisticsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Margin="0,0,10,20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox ItemsSource="{Binding Periods}" SelectedIndex="{Binding PeriodIndex}" Width="180" />
                <CalendarDatePicker SelectedDate="{Binding SelectedDate}" Width="180" />
                <TextBlock Text="{Binding PeriodLabel}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                <Border Classes="panel" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Translate Statistics.Active}" Classes="muted" />
                        <TextBlock Text="{Binding Active}" FontSize="28" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="panel" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Translate Filters.Overdue}" Classes="muted" />
                        <TextBlock Text="{Binding Overdue}" FontSize="28" Foreground="#FF8DA9" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="panel" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Translate Filters.Completed}" Classes="muted" />
                        <TextBlock Text="{Binding Completed}" FontSize="28" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Classes="panel" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Translate Statistics.OnTime}" Classes="muted" />
                        <TextBlock Text="{Binding OnTimeRate}" FontSize="24" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{loc:Translate Statistics.Categories}" Classes="section" />
            <DataGrid ItemsSource="{Binding Categories}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Translate Tasks.Category}" Binding="{Binding Category}" Width="*" />
                    <DataGridTextColumn Header="{loc:Translate Statistics.TaskCount}" Binding="{Binding TaskCount}" />
                    <DataGridTextColumn Header="{loc:Translate WorkTime.PlannedMinutes}" Binding="{Binding PlannedMinutes}" />
                    <DataGridTextColumn Header="{loc:Translate WorkTime.ActualMinutes}" Binding="{Binding ActualMinutes}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{loc:Translate Statistics.Hint}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8DA9" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>