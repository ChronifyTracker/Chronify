<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chronify.ViewModels"
        x:Class="Chronify.Views.AddTaskWindow"
        x:DataType="vm:AddTaskViewModel"
        Title="{Binding Heading}" Width="560" Height="680"
        CanResize="False" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" Margin="28">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18">
                <TextBlock Text="{Binding Heading}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Spacing="7">
                    <TextBlock Text="Название" Classes="muted" />
                    <TextBox x:Name="TitleInput" Text="{Binding Title}" Watermark="Что нужно сделать?" MaxLength="200" />
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Text="Описание" Classes="muted" />
                    <TextBox Text="{Binding Description}" Watermark="Необязательно" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="90" />
                </StackPanel>
                <StackPanel Spacing="7">
                    <TextBlock Text="Категория" Classes="muted" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              HorizontalAlignment="Stretch" IsEnabled="{Binding CategoriesLoaded}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryOption">
                                <TextBlock Text="{Binding Name}" Classes.accent="{Binding IsAddNew}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Не удалось загрузить категории." Foreground="#FF8DA9"
                               IsVisible="{Binding !CategoriesLoaded}" />
                    <TextBox x:Name="NewCategoryInput" Text="{Binding NewCategoryName}"
                             Watermark="Название новой категории" MaxLength="50"
                             IsVisible="{Binding IsAddingCategory}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Spacing="7">
                        <TextBlock Text="Приоритет" Classes="muted" />
                        <ComboBox SelectedIndex="{Binding PriorityIndex}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Отложено" />
                            <ComboBoxItem Content="Низкий" />
                            <ComboBoxItem Content="Средний" />
                            <ComboBoxItem Content="Высокий" />
                            <ComboBoxItem Content="Критический" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="7">
                        <TextBlock Text="Сколько займёт, мин" Classes="muted" />
                        <NumericUpDown x:Name="MinutesInput" Value="{Binding Minutes}"
                                       Increment="15" FormatString="0" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Spacing="7">
                        <TextBlock Text="Дата" Classes="muted" />
                        <CalendarDatePicker SelectedDate="{Binding DueDate}"
                                            Watermark="Без срока" SelectedDateFormat="Short"
                                            HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="7">
                        <TextBlock Text="Время" Classes="muted" />
                        <TimePicker SelectedTime="{Binding DueTime}" ClockIdentifier="24HourClock"
                                    HorizontalAlignment="Stretch" ToolTip.Tip="Учитывается, если выбрана дата" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,20,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8DA9" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button Content="Отмена" Click="Cancel" />
                <Button Content="{Binding SaveText}" Classes="primary" Click="Save" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
