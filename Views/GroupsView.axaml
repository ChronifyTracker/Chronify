<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:Chronify.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Chronify.ViewModels" x:Class="Chronify.Views.GroupsView" x:DataType="vm:GroupsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,12,20">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8DA9" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" Foreground="#81C784" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RefreshNotice}" IsVisible="{Binding HasRefreshNotice}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Translate Common.Working}" IsVisible="{Binding IsBusy}" Classes="muted" />
            <StackPanel Spacing="16" IsEnabled="{Binding !IsBusy}">
                <TextBlock Text="{loc:Translate Groups.OfflineHint}" TextWrapping="Wrap" Classes="muted" />
                <TextBlock Text="{Binding ConnectionNotice}" TextWrapping="Wrap" Foreground="#F2B45A" />
                <Button Content="{loc:Translate Groups.Refresh}" Command="{Binding SynchronizeCommand}" IsEnabled="{Binding IsConnected}" />
                <Border Classes="panel" Padding="20" IsEnabled="{Binding IsConnected}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,12,Auto">
                            <TextBox Text="{Binding GroupName}" Watermark="{loc:Translate Groups.NewName}" MaxLength="80" />
                            <Button Grid.Column="2" Content="{loc:Translate Groups.Create}" Command="{Binding CreateGroupCommand}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,12,Auto">
                            <TextBox Text="{Binding InviteCode}" Watermark="{loc:Translate Groups.InviteCode}" MaxLength="32" />
                            <Button Grid.Column="2" Content="{loc:Translate Groups.Join}" Command="{Binding JoinGroupCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" PlaceholderText="{loc:Translate Groups.MyGroups}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding GroupDetails}" TextWrapping="Wrap" />
                <Border Classes="panel" Padding="20" IsVisible="{Binding CanViewGroup}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Translate Groups.Members}" Classes="section" />
                        <ComboBox ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}" HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAdministrator}">
                            <Button Content="{loc:Translate Groups.MakeTeamLead}" Command="{Binding MakeTeamLeadCommand}" />
                            <Button Content="{loc:Translate Groups.MakeExecutor}" Command="{Binding MakeExecutorCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="panel" Padding="20" IsVisible="{Binding CanAssign}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Translate Groups.AssignTask}" Classes="section" />
                        <ComboBox ItemsSource="{Binding Assignees}" SelectedItem="{Binding Assignee}" PlaceholderText="{loc:Translate Groups.Assignee}" HorizontalAlignment="Stretch" />
                        <TextBox Text="{Binding TaskTitle}" Watermark="{loc:Translate Tasks.TaskTitle}" MaxLength="200" />
                        <TextBox Text="{Binding TaskDescription}" Watermark="{loc:Translate Tasks.Details}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxLength="50000" />
                        <WrapPanel>
                            <StackPanel Spacing="6" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Translate Groups.EndOfDay}" Classes="muted" />
                                <CalendarDatePicker SelectedDate="{Binding DueDate}" Watermark="{loc:Translate Tasks.NoDueDate}" />
                            </StackPanel>
                            <StackPanel Spacing="6" Margin="0,0,16,0">
                                <TextBlock Text="{loc:Translate Tasks.EstimateMinutes}" Classes="muted" />
                                <NumericUpDown Value="{Binding EstimatedMinutes}" Minimum="0" Maximum="100000" Increment="15" Width="150" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Translate Tasks.Importance}" Classes="muted" />
                                <ComboBox ItemsSource="{Binding Priorities}" SelectedIndex="{Binding PriorityIndex}" />
                            </StackPanel>
                        </WrapPanel>
                        <ComboBox ItemsSource="{Binding InitialStatuses}" SelectedIndex="{Binding InitialStatusIndex}" HorizontalAlignment="Stretch" />
                        <Button Content="{loc:Translate Groups.AssignTask}" Command="{Binding AssignTaskCommand}" Classes="primary" />
                    </StackPanel>
                </Border>
                <Border Classes="panel" Padding="20" IsVisible="{Binding CanViewGroup}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Translate Groups.Assignments}" Classes="section" />
                        <TextBlock Text="{loc:Translate Groups.VisibilityHint}" TextWrapping="Wrap" Classes="muted" />
                        <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" MaxHeight="260" />
                        <TextBlock Text="{Binding SelectedTaskDetails}" TextWrapping="Wrap" />
                        <Button Content="{loc:Translate Groups.StartTask}" Command="{Binding StartTaskCommand}" IsEnabled="{Binding CanStartSelected}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
